# Keep the build context small and free of local state.
# tests/ and requirements-dev.txt stay in: the "test" stage needs them,
# and they never reach the runtime stage.
.git
.gitignore
.venv*
venv
**/__pycache__
**/*.py[cod]
.pytest_cache
.coverage
coverage.xml
htmlcov
reports
dist
build
*.egg-info
.scannerwork
*.db
.DS_Store
.idea
.vscode
infra
k8s
scripts
legacy
Jenkinsfile
sonar-project.properties
README.md
CHANGELOG.md
